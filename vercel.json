{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "laravel",
  "buildCommand": "composer install --no-dev && npm ci && npm run build && php artisan package:discover --ansi && php artisan filament:assets && php artisan vendor:publish --tag=laravel-assets --force --ansi",
  "outputDirectory": "public",
  "installCommand": "composer install --no-dev --prefer-dist --optimize-autoloader",
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "DB_CONNECTION": "pgsql",
    "CACHE_STORE": "database",
    "SESSION_DRIVER": "database",
    "QUEUE_CONNECTION": "database"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/build/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/storage/(.*)",
      "destination": "/storage/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/schedule",
      "schedule": "0 * * * *"
    }
  ]
}
